{
  "name": "foliant",
  "productName": "Foliant",
  "version": "0.1.0",
  "description": "A calm, reliable writing app for fiction.",
  "main": "./out/main/index.js",
  "author": "Ksenia",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "electron-vite build && node tests/e2e/smoke.cjs",
    "dist:win": "electron-vite build && electron-builder --win --x64",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "devDependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@tiptap/extension-highlight": "^3.35.0",
    "@tiptap/extension-text-align": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "diff": "^9.0.0"
  },
  "build": {
    "appId": "app.foliant.writer",
    "productName": "Foliant",
    "copyright": "Ksenia",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Foliant",
      "artifactName": "Foliant-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ]
    },
    "mac": {
      "target": [
        "dir"
      ]
    }
  }
}
